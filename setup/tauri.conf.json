{
  "productName": "Jay-Test",
  "version": "0.0.0",
  "identifier": "io.github.tyxmatty.jayi.setup",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "img-src": "'self' http://jayi.localhost jayi:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
